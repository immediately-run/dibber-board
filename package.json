{
  "name": "@immediately-run/dibber-board",
  "private": true,
  "version": "1.0.0",
  "main": "src/main.tsx",
  "type": "module",
  "description": "The Dibber board: open a repository's Dibber ticket store on immediately.run as a read-only kanban board, ticket pages and project pages. An ordinary immediately.run app on the Grove thin shell.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immediately-run/dibber-board.git"
  },
  "immediately.run": {
    "$schema": "https://immediately.run/immediately-run-config.schema.json",
    "render": "app",
    "opens": [
      {
        "app": "self",
        "version": "^1"
      }
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@immediately-run/grove": "github:immediately-run/grove#e5e32849d946e1729bde8eff83102fa24d822335",
    "@immediately-run/mdx-plugins": "0.8.0",
    "@immediately-run/sdk": "^0.93.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "~6.0.2",
    "vitest": "^4.1.9"
  }
}
